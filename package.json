{
  "name": "@genm/switchbot-mcp",
  "version": "2.0.0",
  "description": "SwitchBot API MCP Server v2 - stdio/Streamable HTTP with secure auth and typed tools",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "start": "node build/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run tests/mcp/stdio-e2e.test.ts",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "prepare": "lefthook install",
    "commitlint": "commitlint --edit"
  },
  "keywords": [
    "mcp",
    "switchbot"
  ],
  "author": "genm",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genm/mcps.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "axios": "^1.13.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@types/node": "^22.18.7",
    "lefthook": "^2.1.1",
    "nock": "^14.0.10",
    "oxlint": "^1.15.0",
    "oxfmt": "^0.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
