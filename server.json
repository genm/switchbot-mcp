{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.genm/switchbot-mcp",
  "title": "SwitchBot MCP",
  "description": "Control SwitchBot devices and scenes through a secure MCP server.",
  "repository": {
    "url": "https://github.com/genm/switchbot-mcp",
    "source": "github"
  },
  "version": "3.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@genm-dev/switchbot-mcp",
      "version": "3.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SWITCHBOT_TOKEN",
          "description": "SwitchBot Open API token",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "SWITCHBOT_SECRET",
          "description": "SwitchBot Open API secret",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
